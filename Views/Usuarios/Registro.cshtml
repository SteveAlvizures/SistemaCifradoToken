@model SistemaCifradoToken.Models.Usuario

@{
    ViewData["Title"] = "Registro de Usuario";
}

<h2>Registro de Usuario</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Registro" method="post">
    <div class="mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="NombreUsuario" class="form-label"></label>
        <input asp-for="NombreUsuario" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <input asp-for="PasswordHash" class="form-control" type="password" />
    </div>

    <button type="submit" class="btn btn-primary">Registrar</button>
</form>